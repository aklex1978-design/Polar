[Unit]
Description=Polar: RTSP-потік камери з USB AV-перетворювача (MediaMTX + ffmpeg)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/polar/polar.env

[Service]
Type=simple
User=polar
Group=polar
SupplementaryGroups=video
EnvironmentFile=/etc/polar/polar.env
RuntimeDirectory=polar
# конфігурація MediaMTX з шаблону: шлях потоку = RTSP_PATH (вмикається/вимикається install.sh за VIDEO_ENABLED)
ExecStartPre=/bin/bash -c 'sed "s|__RTSP_PATH__|${RTSP_PATH:-camera_1}|" /opt/polar/mediamtx.yml > /run/polar/mediamtx.yml'
ExecStart=/opt/polar/mediamtx /run/polar/mediamtx.yml
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
