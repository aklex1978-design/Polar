# /etc/polar/polar.env — налаштування Raspberry Pi однієї камери Polar.
# Скопіюйте:  sudo cp polar.env.example /etc/polar/polar.env  і змініть під свою камеру.
# Після змін:  sudo systemctl restart polar-pantilt polar-video

# --- камера і ROS 2 (мають збігатися з сервером) ---------------------------------------------
# простір імен камери — як «Простір імен ROS 2» у формі камери на сервері
CAMERA_NS=camera_1
# «Налаштування → ROS 2» на сервері: префікс топіків, домен, реалізація DDS
TOPIC_PREFIX=/polar
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Discovery Server (адреса:порт), якщо multicast у мережі заблокований; порожньо — multicast
ROS_DISCOVERY_SERVER=
# порт rosbridge (WebSocket): через нього Polar на Windows керує камерою без ROS 2 на сервері;
# має збігатися з «Налаштування → ROS 2 → Порт rosbridge на Pi»
ROSBRIDGE_PORT=9090

# --- сервоприводи -----------------------------------------------------------------------------
# st3020 — справжні сервоприводи через HAT; sim — імітатор (перевірка без механіки)
SERVO_BACKEND=st3020

# --- відео з USB AV-перетворювача (CVBS) ---------------------------------------------------------
# 1 — Pi віддає RTSP-потік камери; 0 — відео йде на сервер окремо (IP-камера тощо)
VIDEO_ENABLED=1
# пристрій перетворювача; стабільна назва — з /dev/v4l/by-id/ (див. README, «Перевірка»)
VIDEO_DEVICE=/dev/video0
# стандарт аналогового сигналу: pal (720×576, 25 к/с) або ntsc (720×480, 30 к/с)
# тепловізори Caddx (Infra 256 CA) — ntsc; нахилені смуги і зелена смуга внизу кадру = стандарт не той
VIDEO_STANDARD=pal
# вхід перетворювача: 0 — зазвичай Composite (CVBS), 1 — S-Video; перевірка: v4l2-ctl -d … --list-inputs
VIDEO_INPUT=0
# деінтерлейсинг (обовʼязково для CVBS: інакше «гребінка» на рухомих обʼєктах дає хибний рух)
VIDEO_DEINTERLACE=1
# бітрейт H.264, біт/с
VIDEO_BITRATE=2000000
# кодер: auto — апаратний h264_v4l2m2m, якщо працює і ширина кадру кратна 32, інакше програмний libx264
# (для 720×576 / 720×480 — завжди libx264: апаратний кодер дає нахилені смуги)
VIDEO_ENCODER=auto
# потік: rtsp://<адреса Pi>:8554/<RTSP_PATH>  — цю адресу вписати у форму камери на сервері (протокол RTSP)
RTSP_PATH=camera_1

# --- час (бажано: час у журналах Pi = час сервера) -------------------------------------------------
# NTP-сервер: адреса сервера Polar (якщо на ньому увімкнено NTP) або порожньо — інтернет-пул Ubuntu
NTP_SERVER=
